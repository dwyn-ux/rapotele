Options -Indexes
DirectoryIndex public/index.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization Header to FastCGI/PHP
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^(app|config|database|storage|tools)(/|$) - [F,L]
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^(index|install|media|telegram_webhook|schedule_reminders|whatsapp_weekly|api|pwa-icon|manifest)\.php$ public/$1.php [L]
    RewriteRule ^(sw\.js|manifest\.json|offline\.html|icon-.*\.png|apple-touch-icon.*\.png|favicon\.ico)$ public/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [L]
</IfModule>

<FilesMatch "(^\.|\.sqlite$|\.db$|\.log$|\.json$|\.sql$|\.env$)">
    Require all denied
</FilesMatch>

<Files "manifest.json">
    Require all granted
</Files>

<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Service-Worker-Allowed "/"
    </Files>
</IfModule>
