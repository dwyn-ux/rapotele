# Copy this file to .env and fill in your values
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database - SQLite (default) or MySQL
DB_DRIVER=sqlite
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=eraport
# DB_USERNAME=root
# DB_PASSWORD=

# Telegram Bot (optional for local)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# School defaults (override in admin panel after install)
# SCHOOL_NAME=Nama Sekolah
# SCHOOL_ACADEMIC_YEAR=2025/2026
# SCHOOL_SEMESTER=Genap
